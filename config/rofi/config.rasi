configuration {
    modi:                 "drun,run,window";
    show-icons:            true;
    icon-theme:            "Papirus-Dark";
    display-drun:          "Apps";
    display-run:           "Run";
    display-window:        "Windows";
    drun-display-format:   "{name}";
    sidebar-mode:          false;
    hover-select:          true;
}

@theme "cyberpunk"
