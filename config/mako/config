# --- Placement ---
layer=top
anchor=top-right
margin=10
sort=-time

# --- Box ---
width=280
height=110
padding=10
border-size=1
border-radius=0

# --- Colors ---
background-color=#0a0e14ee
text-color=#d6f6ff
border-color=#00d9ff
progress-color=over #0066ff

# --- Text ---
font=Iosevka Nerd Font 10
markup=1
format=<b>%s</b>\n%b

# --- Behavior ---
default-timeout=4000
ignore-timeout=false
max-visible=5
group-by=app-name

# --- Icons ---
icons=1
max-icon-size=48
icon-location=left

# --- Actions ---
on-button-left=dismiss
on-button-middle=dismiss-group
on-button-right=exec makoctl menu
on-touch=dismiss

[urgency=low]
border-color=#5c7a8a
default-timeout=3000

[urgency=normal]
border-color=#00d9ff

[urgency=critical]
layer=overlay
border-color=#ff2d6f
background-color=#1a0a10ee
default-timeout=0

[app-name=OSD]
layer=overlay
border-color=#00d9ff
default-timeout=1000
