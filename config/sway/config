# ==============================================================================
# SWAY CONFIGURATION
# Integration: Noctalia (Handles Bar, Wallpaper, Idle, OSD, Notifications, Menu)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables
# ------------------------------------------------------------------------------
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu noctalia msg panel-toggle launcher

# Cyberpunk Blue Palette
set $bg        #0a0e14
set $bg-alt    #10141c
set $fg        #d6f6ff
set $fg-dim    #5c7a8a
set $accent    #00d9ff
set $accent2   #0066ff
set $urgent    #ff2d6f
set $border-w  #1a2530

# ------------------------------------------------------------------------------
# 2. Output Configuration
# ------------------------------------------------------------------------------
output HDMI-A-1 resolution 3440x1440@100Hz position 0,0 scale 1
output eDP-1 disable

# ------------------------------------------------------------------------------
# 3. Input Configuration
# ------------------------------------------------------------------------------
input type:keyboard {
    xkb_layout us,ir
    xkb_variant ,winkeys
    xkb_options grp:win_space_toggle
    repeat_delay 300
    repeat_rate 50
    xkb_numlock enabled
}

input type:pointer {
    accel_profile flat
    pointer_accel 0.25
}

input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

# ------------------------------------------------------------------------------
# 4. Look & Feel
# ------------------------------------------------------------------------------
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none

gaps inner 8
gaps outer 2
smart_gaps off
smart_borders off

font pango:Hack 10

# ------------------------------------------------------------------------------
# 5. Window Rules
# ------------------------------------------------------------------------------
for_window [app_id="floatterm"] floating enable, resize set 640 400, move position center, border pixel 2

# ------------------------------------------------------------------------------
# 6. Core Keybindings
# ------------------------------------------------------------------------------
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway? This ends your Wayland session.' -B 'Yes' 'swaymsg exit'
floating_modifier $mod normal

# ------------------------------------------------------------------------------
# 7. Window Management Keybindings
# ------------------------------------------------------------------------------
# Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+a focus parent

# Move
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move to Workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout & Modes
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resizing Mode
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ------------------------------------------------------------------------------
# 8. Media, System, & Noctalia Keybindings
# ------------------------------------------------------------------------------
# Power Menu & Settings
bindsym $mod+Shift+Escape exec noctalia msg panel-toggle session
bindsym $mod+c exec noctalia msg panel-toggle control-center
bindsym $mod+comma exec noctalia msg settings-toggle

# Volume (Noctalia Native OSD)
bindsym --locked XF86AudioMute exec noctalia msg volume-mute
bindsym $mod+F1 exec noctalia msg volume-mute
bindsym --locked XF86AudioLowerVolume exec noctalia msg volume-down
bindsym $mod+F2 exec noctalia msg volume-down
bindsym --locked XF86AudioRaiseVolume exec noctalia msg volume-up
bindsym $mod+F3 exec noctalia msg volume-up
bindsym --locked XF86AudioMicMute exec noctalia msg mic-mute
bindsym $mod+F4 exec noctalia msg mic-mute

# Media (Noctalia Native OSD)
bindsym --locked XF86AudioPlay exec noctalia msg media toggle
bindsym --locked XF86AudioPause exec noctalia msg media toggle
bindsym --locked XF86AudioPrev exec noctalia msg media previous
bindsym --locked XF86AudioNext exec noctalia msg media next
bindsym --locked XF86AudioStop exec noctalia msg media stop

# Brightness (Noctalia Native OSD)
bindsym --locked XF86MonBrightnessDown exec noctalia msg brightness-down
bindsym --locked XF86MonBrightnessUp exec noctalia msg brightness-up

# Screenshots (Noctalia)
bindsym Print exec noctalia msg screenshot-region
bindsym Shift+Print exec noctalia msg screenshot-fullscreen

# Floating TUI Utilities
bindsym $mod+F5 exec kitty --class floatterm -o "map esc quit" -o confirm_os_window_close=0 -e bluetui
bindsym $mod+F6 exec kitty --class floatterm -o "map esc quit" -o confirm_os_window_close=0 -e wifitui
bindsym $mod+F7 exec kitty --class floatterm -o "map esc quit" -o confirm_os_window_close=0 -e wiremix
bindsym $mod+F8 exec kitty --class floatterm -o "map esc quit" -o confirm_os_window_close=0 -e clipse

# ------------------------------------------------------------------------------
# 9. Autostart & Executions
# ------------------------------------------------------------------------------
# Environment Variables
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway

# Authentication Agents
exec /usr/lib/polkit-kde-authentication-agent-1
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Core Daemons
exec noctalia
exec clipse -listen

include @sysconfdir@/sway/config.d/*



include ~/.config/sway/noctalia
